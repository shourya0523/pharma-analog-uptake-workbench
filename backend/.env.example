# Copy to backend/.env
ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./storage/workbench.db
STORAGE_BACKEND=local
JOB_BACKEND=inprocess
LOCAL_STORAGE_ROOT=./storage
AWS_REGION=us-east-1
AWS_PROFILE=Sandbox
# S3_BUCKET=
# SQS_QUEUE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL_EXTRACT=openai/gpt-4o-mini
OPENROUTER_MODEL_JUDGE=openai/gpt-4o-mini
VALIDATION_SAMPLE_RATE=0.10
MAX_CONCURRENT_JOBS=1
SEC_MAX_FILINGS=4
SEC_INCLUDE_8K=false
# Quarterly product revenue comes from 8-K item 2.02 exhibit 99.x earnings releases
SEC_EARNINGS_EXHIBITS=true
SEC_MAX_EARNINGS_EXHIBITS=6
LLM_SKIP_JUDGE_WHEN_DETERMINISTIC=true
LLM_MAX_EXTRACT_SOURCES=6
ENABLE_LLM_SEARCH=true
LLM_SEARCH_ENGINE=auto
LLM_SEARCH_MAX_QUERIES=4
LLM_SEARCH_MAX_URLS=5
# Optional comma-separated allowlist for OpenRouter web_search / web_fetch (empty = no filter)
# LLM_SEARCH_ALLOWED_DOMAINS=sec.gov,fda.gov,jnj.com,unitedtherapeutics.com
SEC_USER_AGENT=PharmaAnalogUptakeWorkbench your-email@example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
