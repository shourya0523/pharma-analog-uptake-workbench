# Copy to backend/.env
ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./storage/workbench.db
STORAGE_BACKEND=local
JOB_BACKEND=inprocess
LOCAL_STORAGE_ROOT=./storage
AWS_REGION=us-east-1
AWS_PROFILE=default
# S3_BUCKET=
# SQS_QUEUE_URL=
# DB_HOST= / DB_NAME= / DB_USER= / DB_PASSWORD=  (set automatically on ECS)
BEDROCK_MODEL_EXTRACT=us.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_JUDGE=us.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_SEARCH=openai.gpt-5.6-terra
# BEDROCK_MANTLE_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/openai/v1
BEDROCK_MAX_TOKENS=4096
VALIDATION_SAMPLE_RATE=0.10
MAX_CONCURRENT_JOBS=1
SEC_MAX_FILINGS=4
SEC_INCLUDE_8K=false
LLM_SKIP_JUDGE_WHEN_DETERMINISTIC=true
LLM_MAX_EXTRACT_SOURCES=3
ENABLE_LLM_SEARCH=true
LLM_SEARCH_MAX_QUERIES=4
LLM_SEARCH_MAX_URLS=5
# Optional comma-separated domain preference for web search prompts (empty = no filter)
# LLM_SEARCH_ALLOWED_DOMAINS=sec.gov,fda.gov,jnj.com,unitedtherapeutics.com
SEC_USER_AGENT=PharmaAnalogUptakeWorkbench your-email@example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
