# Copy to backend/.env
ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./storage/workbench.db
STORAGE_BACKEND=local
JOB_BACKEND=inprocess
LOCAL_STORAGE_ROOT=./storage
AWS_REGION=us-east-1
AWS_PROFILE=Sandbox
# S3_BUCKET=
# SQS_QUEUE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL_EXTRACT=openai/gpt-4o-mini
OPENROUTER_MODEL_JUDGE=openai/gpt-4o-mini
VALIDATION_SAMPLE_RATE=0.10
MAX_CONCURRENT_JOBS=3
SEC_USER_AGENT=PharmaAnalogUptakeWorkbench your-email@example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
