# Copy to deploy/.env on the VM and fill in. deploy/.env is gitignored and must
# stay that way: it is the only place a key lives.
#
#   cp deploy/env.example deploy/.env && chmod 600 deploy/.env

# --- The address the box answers on -----------------------------------------
# Caddy takes the scheme from this. A hostname means it obtains and renews a
# Let's Encrypt certificate; anything else means it does not.
#
#   a domain you own      SITE_ADDRESS=workbench.example.com
#   no domain             SITE_ADDRESS=203-0-113-9.sslip.io
#                         (sslip.io resolves a hostname to the address written
#                          in it, so substitute the VM's own external IP with
#                          dots replaced by hyphens)
#   plain HTTP, no cert   SITE_ADDRESS=:80
#
# The A record must already point here before the stack starts, because the
# certificate is issued against an HTTP request Let's Encrypt makes to it.
SITE_ADDRESS=

# --- Secrets ----------------------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# SEC's fair-access policy requires a real contact address on every request,
# and blocks by user agent rather than answering. Put a mailbox that is read.
SEC_USER_AGENT=PharmaAnalogUptakeWorkbench you@example.com

# --- Sizing for 1 GB of RAM -------------------------------------------------
# Each concurrent job holds the document it is parsing. Raise only while
# watching `docker stats`.
MAX_CONCURRENT_JOBS=1

# --- Where documents land ---------------------------------------------------
# Host path bind-mounted at /app/storage. Relative paths resolve against
# deploy/. Point it at a separate disk by giving an absolute path.
STORAGE_ROOT=./storage

# --- Which published images to run ---
# Unset means the moving `main` tag, which is what continuous deployment
# follows. Set it to a commit SHA to pin the box to that build; the update
# timer pulls whatever this names, so a pinned box stays pinned.
# IMAGE_TAG=

# --- Pipeline settings ------------------------------------------------------
# These match backend/.env.example; change them the same way you would locally.
OPENROUTER_MODEL_EXTRACT=openai/gpt-4o-mini
OPENROUTER_MODEL_JUDGE=openai/gpt-4o-mini
VALIDATION_SAMPLE_RATE=0.10
SEC_MAX_FILINGS=4
SEC_INCLUDE_8K=false
SEC_EARNINGS_EXHIBITS=true
SEC_MAX_EARNINGS_EXHIBITS=6
LLM_SKIP_JUDGE_WHEN_DETERMINISTIC=true
LLM_MAX_EXTRACT_SOURCES=6
ENABLE_PROFILE_JUDGE=true
PROFILE_JUDGE_MAX_FIELDS=0
PROFILE_JUDGE_MIN_CONFIDENCE=0.6
ENABLE_LLM_SEARCH=true
LLM_SEARCH_ENGINE=auto
LLM_SEARCH_MAX_QUERIES=4
LLM_SEARCH_MAX_URLS=5
